# Neon Postgres connection string (from the Neon dashboard, "pooled" URL)
DATABASE_URL=

# Any long random string — sign-in session encryption
AUTH_SECRET=

# Any long random string you invent — protects the one-time /setup page.
# Set it in Vercel env vars; you'll type it into /setup in the browser.
SETUP_SECRET=

# Set to your deployed URL in production (Vercel usually detects this)
# AUTH_URL=https://<your-app>.vercel.app

# Any long random string you invent — protects the CSV export routes used
# for the Google Sheets IMPORTDATA setup. Treat it like a password: anyone
# with the token can read (not modify) your bills/vendors/items data.
EXPORT_TOKEN=
