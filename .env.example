# Neon Postgres connection string (from the Neon dashboard, "pooled" URL)
DATABASE_URL=

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# From Google Cloud Console -> APIs & Services -> Credentials
# OAuth 2.0 Client ID, type "Web application"
# Authorized redirect URI (local):  http://localhost:3000/api/auth/callback/google
# Authorized redirect URI (prod):   https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set to your deployed URL in production (Vercel sets this automatically)
# AUTH_URL=https://<your-app>.vercel.app

# Any long random string you invent — protects the one-time /setup page.
# Set it in Vercel env vars; you'll type it into /setup in the browser.
SETUP_SECRET=
